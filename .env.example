# MongoDB connection URI (e.g. local instance or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/sports_academy

# Session Secret (minimum 32 characters for HMAC signing)
SESSION_SECRET=replace_with_a_secure_random_session_secret_min_32_chars

# Staff Provisioning Secret (for server-side Coach & Scout account provisioning)
STAFF_PROVISIONING_SECRET=replace_with_a_secure_staff_provisioning_key

